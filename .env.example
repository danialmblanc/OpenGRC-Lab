# .env.example
# Copy this file to .env and fill in the values

# App Configuration
NEXT_PUBLIC_APP_NAME="OpenGRC Lab"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode Configuration
# Set to 'true' to enable mock authentication and demo features
NEXT_PUBLIC_DEMO_MODE="true"
DEMO_AUTH_ENABLED="true"
DEMO_JWT_SECRET="replace_this_with_a_long_random_string_for_demo_only"

# Database Configuration
# For local development with SQLite:
DATABASE_URL="file:./dev.db"

# For production with PostgreSQL:
# DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Content Configuration
NEXT_PUBLIC_DEFAULT_USER_ROLE="learner"
NEXT_PUBLIC_VIDEO_PROVIDER="youtube"

# Media Storage
# Options: 'local', 's3', 'gcs'
MEDIA_STORAGE_MODE="local"
LOCAL_UPLOAD_DIR="./public/uploads"

# AI Integration (Optional)
GEMINI_API_KEY=""
